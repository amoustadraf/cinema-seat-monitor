# Required: Discord channel webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me/replace-me

# Optional: Discord user or role mention included with ticket alerts.
# User: <@123456789012345678>
# Role: <@&123456789012345678>
DISCORD_MENTION=

# Set false only when running locally without Discord.
DISCORD_ENABLED=true

# Required: Cineplex API subscription key used by its public ticketing frontend.
CINEPLEX_API_KEY=
