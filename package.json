{
  "name": "cinema-seat-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable Cineplex seat availability monitor with Discord alerts",
  "type": "module",
  "scripts": {
    "check": "node monitor.js",
    "check:now": "node monitor.js --force",
    "dry-run": "node monitor.js --force --dry-run",
    "notify-test": "node monitor.js --notify-test",
    "notify-failure": "node monitor.js --notify-failure",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
